# ───────── LINE ─────────
# LIFF app id (จาก LINE Developers → LIFF) — ใช้ฝั่ง client
NEXT_PUBLIC_LIFF_ID=
# LINE Login channel (ใช้ verify ID token ฝั่ง server)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ───────── Supabase ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — อย่าเผยแพร่
SUPABASE_SERVICE_ROLE_KEY=
# ใช้เซ็น Supabase-compatible JWT เพื่อให้ RLS ทำงาน (ADR-0002)
SUPABASE_JWT_SECRET=

# ───────── App ─────────
# LINE userId ของแอดมินคนแรก (คั่นด้วย comma) — seed สิทธิ์ admin
ADMIN_LINE_USER_IDS=

# (ภายหลัง / optional) Messaging API สำหรับ push แจ้งเตือนถึงสมาชิก
# LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
